{
  "description": "visual-grilling: when the agent session ends, stop its grilling server and delete the session's files.",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/visual-grilling/dist/cli.mjs\" end --hook",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
